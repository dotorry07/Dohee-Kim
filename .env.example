# Copy this file to .env.local on each team member's computer.
# Do not commit .env.local.

# auto: use Supabase when URL/public key exist, otherwise use the mock auth API.
# Set mock or supabase to force a provider explicitly.
NEXT_PUBLIC_AUTH_PROVIDER=auto

# Optional signing secret for mock auth cookies. A development-only fallback is
# used when omitted. Set a long random value when sharing a deployed demo.
MOCK_AUTH_SECRET=

# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Use either one of these public browser keys depending on your Supabase project UI.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key. Keep this private and share only through a secure channel.
# Never commit the real service role key to Git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
